# Database Configuration
# The pooled connection string — every application query runs through it. On
# PlanetScale this is the PgBouncer endpoint; on a local container it is just
# the database.
#
# PlanetScale shows ONE string per role and no pooled variant to hunt for: the
# pooler is the same credentials on a different PORT, running on the primary's
# own node, already on. 6432 is PgBouncer; 5432 is Postgres itself. So the two
# below differ by their port — and, if you split the roles, by which one they
# authenticate as.
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai-app-template"
# Optional. The direct-to-primary connection string, used only by migrations
# (drizzle-kit and db:baseline). A transaction-mode pooler cannot carry
# session-level DDL state, so migrations must bypass it. Unset locally, where
# there is no pooler — migrations then fall back to DATABASE_URL.
# DIRECT_DATABASE_URL="postgresql://user:password@host.psdb.cloud:5432/db"

# The cvm CLI
# cvm reaches the domain data over HTTP, through the deployed API in
# apps/remote — the author's own invocations and an agent's alike, so the path
# an agent depends on is the path exercised every day. Neither of these is a
# database credential: a compromised box hands over a revocable token, not full
# Postgres access.
#
# On a remote box these are set as real environment variables and there is no
# .env at all. Mint the token from the "API Tokens" page in the local UI — it
# is shown once, at mint time.
CVM_API_URL="https://your-cvm-api.vercel.app"
CVM_API_TOKEN="cvm_xxxxxxxx_your_minted_token_here"
# Declares THIS machine as the author's — the one with the finished videos
# directory, the Video Files directory, ffmpeg and OBS on it. `cvm file`,
# `cvm course readiness` and `cvm course publish` need those and refuse to run
# anywhere else (exit 7), naming the reason so an agent stops rather than
# retries an ENOENT. It is declared rather than detected because every signal
# that could be detected is wrong in the dangerous direction; a box that says
# nothing is treated as remote, which is the safe default. NEVER set this on a
# remote box.
CVM_LOCAL_MACHINE="true"

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# File Paths
FINISHED_VIDEOS_DIRECTORY="/path/to/finished-videos"

# Dropbox API (publish transport)
# Create a scoped app at https://www.dropbox.com/developers/apps with
# full-Dropbox access. The remote path is the Courses folder within the account.
DROPBOX_APP_KEY="your_dropbox_app_key_here"
DROPBOX_APP_SECRET="your_dropbox_app_secret_here"
DROPBOX_REMOTE_PATH="/Courses"
# How many Videos stream to Dropbox at once during a Publish, and the
# upload-session chunk size (Dropbox recommends multiples of 4 MB). A Publish's
# resident memory ceiling is roughly the two multiplied together.
# DROPBOX_UPLOAD_CONCURRENCY="4"
# DROPBOX_UPLOAD_CHUNK_SIZE_MB="16"

# Course storage backend: where a Publish sends Bundles and course.json.
# "dropbox" (default) or "google-drive". See docs/adr/0029.
# COURSE_STORAGE_BACKEND="google-drive"

# Google Drive (publish transport, when COURSE_STORAGE_BACKEND="google-drive")
# A Web OAuth client in Google Cloud with the Drive API enabled and redirect
# URI http://localhost:5173/api/auth/google-drive/callback. After setting
# these, visit /api/auth/google-drive/initiate once to connect the account.
# The courses folder is named by its Drive folder ID (the last URL segment).
# GOOGLE_DRIVE_CLIENT_ID="your_drive_oauth_client_id"
# GOOGLE_DRIVE_CLIENT_SECRET="your_drive_oauth_client_secret"
# GOOGLE_DRIVE_COURSES_FOLDER_ID="your_courses_folder_id"
# GOOGLE_DRIVE_UPLOAD_CONCURRENCY="4"
# GOOGLE_DRIVE_UPLOAD_CHUNK_SIZE_MB="16"

# Video Files
# Directory where per-video scratch files are stored, keyed by lineageId.
# Files are organized as: {VIDEO_FILES_DIR}/{lineageId}/{filename}
VIDEO_FILES_DIR="/path/to/video-files"

# Diagram Thumbnails
# Directory where PNG thumbnails of preserved diagram snapshots are stored.
# Files are organized as: {DIAGRAM_THUMBNAILS_DIR}/{diagramId}/{contentHash}.png
DIAGRAM_THUMBNAILS_DIR="/path/to/diagram-thumbnails"

# Overlay Render Cache
# Directory where rendered Definition Cards are cached, one transparent .mov
# per distinct card content. Safe to delete: every file is re-rendered on
# demand from the database.
# Files are organized as: {OVERLAY_RENDER_CACHE_DIRECTORY}/{courseId}-{contentHash}.mov
OVERLAY_RENDER_CACHE_DIRECTORY="/path/to/overlay-renders"

# Google OAuth (for YouTube uploads)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Social posts (Buffer, by way of Make)
# "Post to Buffer" stages the exported vertical video in this Google Drive
# folder (by folder ID; uses the Google Drive connection above), then POSTs
# {caption, googleDriveFileId, videoId, fileName} to the "CVM -> Buffer" Make
# scenario's Custom Webhook. Staged files older than 7 days are trashed.
# GOOGLE_DRIVE_SOCIAL_STAGING_FOLDER_ID="your_social_staging_folder_id"
# MAKE_SOCIAL_WEBHOOK_URL="https://hook.us2.make.com/your-webhook-id"

# Background Removal (remove.bg)
# Get an API key at https://www.remove.bg/api (50 free images/month)
REMOVE_BG_API_KEY="your_remove_bg_api_key_here"

# Space Desk (virtual TikTok-shaped monitor)
# The "Space Desk" sidebar button opens a modal to enter the server IP (saved in
# local storage). Only the port is configurable via env (defaults to 28252):
# SPACEDESK_PORT="28252"
